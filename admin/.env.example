SECRET_KEY=change-this-to-a-long-random-secret
FLASK_DEBUG=False
ADMIN_USERNAME=
# Prefer a generated Werkzeug password hash.  ADMIN_PASSWORD is accepted only
# for local development when a hash cannot be provisioned yet.
ADMIN_PASSWORD_HASH=
# ADMIN_PASSWORD=
# Use the same TiDB/database and table schema as the main website.
MYSQL_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com
MYSQL_PORT=4000
MYSQL_USER=your-tidb-user
MYSQL_PASSWORD=your-tidb-password
MYSQL_DATABASE=your-main-site-database
MYSQL_SSL_MODE=REQUIRED
# Set MYSQL_SSL_CA only for VERIFY_CA or VERIFY_IDENTITY, and point it to an existing trusted CA file.
MAIN_SITE_URL=http://localhost:5000
SESSION_COOKIE_SECURE=True
